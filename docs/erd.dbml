  "provider" AuthProvider [note: 'Java AuthProvider; field=provider; 논리 컬럼명; @Column name 미지정; @Enumerated(EnumType.STRING); DB enum/SQL type 미확정']
  "providerUserId" String [note: 'Java String; field=providerUserId; 논리 컬럼명; @Column name 미지정']
  "createdAt" Instant [note: 'Java Instant; field=createdAt; 논리 컬럼명; @Column name 미지정']
  "updatedAt" Instant [note: 'Java Instant; field=updatedAt; 논리 컬럼명; @Column name 미지정']
  "lastLoginAt" Instant [note: 'Java Instant; field=lastLoginAt; 논리 컬럼명; @Column name 미지정']
}

